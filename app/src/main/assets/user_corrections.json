  "learned_rules": [
    {
      "id": "regional_currency_topup_v2",
      "priority": 5,
      "description": "최신 Finance OS 정책: 은행/현금계정에서 경기지역화폐 자체로 빠져나가는 충전은 소비가 아닌 자산이동/선불충전.",
      "match": {
        "raw_type_equals": "지출",
        "content_equals": "경기지역화폐",
        "direction": "outflow"
      },
      "action": {
        "name": "경기지역화폐 충전",
        "type": "자산이동",
        "major": "자산이동",
        "minor": "선불충전",
        "status": "확정",
